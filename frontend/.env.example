# ==============================================================
#  RIEAL H2O — Environment variables
# ==============================================================
#  Copy this file to `.env` (git-ignored) and fill in real values.
#  On Vercel: add the same keys under
#      Project Settings → Environment Variables
#  (add to Production AND Preview).
# --------------------------------------------------------------
#  IMPORTANT:
#    • Keys prefixed  VITE_*  are baked into the browser bundle —
#      only use them for values that are safe to expose.
#    • Keys WITHOUT the VITE_ prefix stay server-side (used by
#      the /api/contact serverless function) — this is where the
#      SMTP password lives. Never prefix SMTP creds with VITE_.
# ==============================================================


# ---------- Server-side (SMTP for /api/contact) ---------------
# We recommend Gmail with an "App Password":
#   1. Turn on 2-Step Verification for your Gmail account.
#   2. Google Account → Security → App Passwords → generate
#      a 16-character password for "Mail".
#   3. Paste it here as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Where enquiries are delivered (usually the business manager)
MANAGER_EMAIL=manager@rieal-h2o.example
MANAGER_NAME=Manager Name
# Shown to the client in the auto-reply so they can call directly
MANAGER_PHONE=+91 00000 00000
# Optional — shown at the bottom of the client's thank-you email
BUSINESS_ADDRESS=RIEAL H2O, Sri Anandpur sahib, Punjab, India


# ---------- Client-side (shown on the website) ----------------
# These are the details displayed in the footer & contact page.
# Safe to be public — they're what customers see.
VITE_CONTACT_EMAIL=riea.h2o@gmail.com
VITE_CONTACT_PHONE=+91 7814998055
VITE_CONTACT_ADDRESS=RIEAL H2O, Sri Anandpur sahib, Punjab, India
